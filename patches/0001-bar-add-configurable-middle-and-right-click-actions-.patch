From 8f40742d6891b9cfd7a6eba1d18f64d86f3a2e08 Mon Sep 17 00:00:00 2001
From: aldair-meneses <aldair.meneses@protonmail.com>
Date: Sat, 26 Sep 2026 01:31:49 -0300
Subject: [PATCH] bar: add configurable middle and right click actions on empty
 space

Revives PR 2710 using in-process PopoutService toggles per review, extended
with a right click action and a follow-mouse option for anchored popouts.
---
 quickshell/Common/settings/SettingsSpec.js    |   3 +
 quickshell/Modules/DankBar/BarSurface.qml     |   5 +-
 quickshell/Modules/DankBar/DankBarBody.qml    |  59 ++++++++-
 quickshell/Modules/Settings/DankBarTab.qml    |  83 +++++++++++++
 .../translations/settings_search_index.json   | 117 ++++++++++++++++++
 5 files changed, 265 insertions(+), 2 deletions(-)

diff --git a/quickshell/Common/settings/SettingsSpec.js b/quickshell/Common/settings/SettingsSpec.js
index 75e66d8d..1d6bd34d 100644
--- a/quickshell/Common/settings/SettingsSpec.js
+++ b/quickshell/Common/settings/SettingsSpec.js
@@ -1351,6 +1351,9 @@ var LOCAL_SPEC = {
                 scrollEnabled: true,
                 scrollXBehavior: "column",
                 scrollYBehavior: "workspace",
+                middleClickAction: "none",
+                rightClickAction: "none",
+                clickActionFollowMouse: false,
                 shadowIntensity: 0,
                 shadowOpacity: 60,
                 shadowColorMode: "default",
diff --git a/quickshell/Modules/DankBar/BarSurface.qml b/quickshell/Modules/DankBar/BarSurface.qml
